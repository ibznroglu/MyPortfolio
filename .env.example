# Firebase web config. These values are public by design - the Realtime
# Database security rules are what actually restrict access.
# Copy this file to .env.local and fill in the values from the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Server-side only — no VITE_ prefix, these must never reach the browser bundle.
# Optional in local development; the contact endpoint falls back to its other guards.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
TURNSTILE_SECRET_KEY=

# Client-side, public.
VITE_TURNSTILE_SITE_KEY=
